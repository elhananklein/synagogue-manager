NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel Cron — מחרוזת אקראית (16+ תווים). Vercel שולח אותה ב-Authorization: Bearer …
CRON_SECRET=your-random-cron-secret

# איפוס סיסמה ("שכחתי סיסמה") דורש ב-Supabase Dashboard → Authentication → URL Configuration:
# Redirect URLs: http://localhost:3000/auth/callback  וגם  https://YOUR_DOMAIN/auth/callback
# (אופציונלי בפרוד: Authentication → SMTP Settings — כדי שמיילי האיפוס יגיעו אמין)

# טופס צור קשר — שליחת מייל (Gmail: App Password בלבד, לא סיסמת החשבון)
# ה-App Password הוא 16 תווים. אם Google מציג עם רווחים — אפשר להדביק עם/בלי; הקוד מנקה רווחים.
CONTACT_SMTP_HOST=smtp.gmail.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=synagogues.manager@gmail.com
CONTACT_SMTP_PASS=abcdefghijklmnop
CONTACT_TO_EMAIL=synagogues.manager@gmail.com

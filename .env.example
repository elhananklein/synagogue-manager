NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# כתובת האתר בפרוד (בלי / בסוף). חשוב לקישורי איפוס סיסמה מ-Vercel.
NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN.vercel.app

# Vercel Cron — מחרוזת אקראית (16+ תווים). Vercel שולח אותה ב-Authorization: Bearer …
CRON_SECRET=your-random-cron-secret

# איפוס סיסמה — Supabase Dashboard → Authentication → URL Configuration:
#   1) Site URL = https://synagogue-manager.vercel.app  (לא localhost — זה מה שנכנס למייל אם אין התאמה)
#   2) Redirect URLs (בדיוק, בלי ?next=...):
#        http://localhost:3000/auth/callback
#        https://synagogue-manager.vercel.app/auth/callback
# אם redirectTo עם query params לא תואם לרשימה — Supabase מחליף ל-Site URL.

# טופס צור קשר — שליחת מייל (Gmail: App Password בלבד, לא סיסמת החשבון)
# ה-App Password הוא 16 תווים. אם Google מציג עם רווחים — אפשר להדביק עם/בלי; הקוד מנקה רווחים.
CONTACT_SMTP_HOST=smtp.gmail.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=synagogues.manager@gmail.com
CONTACT_SMTP_PASS=abcdefghijklmnop
CONTACT_TO_EMAIL=synagogues.manager@gmail.com
